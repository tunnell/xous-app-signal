:name: xas-smoke

# Renode boot script for the xas Signal client smoke test.
#
# Delegates to xous-core's `betrusted.resc` for all SoC peripheral
# wiring, kernel + image load, and reset. The xas binary is bundled
# in the image via apps/manifest.json's `"xas"` entry. xas starts
# at boot like every other PID, so the `log::info!("xas: starting")`
# line at the top of `main()` appears on the UART without any user
# interaction — which is what the Robot test asserts on.
#
# Build dependencies:
#   - xous-core's xtask has been run with our prebuilt ELF:
#       cargo xtask app-image xas:$XAS_DIST_DIR/xas --git-describe v0.9.21-0-g0000000
#   - The resulting `loader.bin` and `xous.img` live in
#       xous-core/target/riscv32imac-unknown-xous-elf/release/
#   - The xous-core repo path is resolved below via the same
#     `repos/xous-core` symlink that BUILDING.md §1 establishes and
#     every Cargo manifest uses as the active-checkout pointer, so the
#     image this smoke test boots is built from the same xous-core the
#     xas ELF was compiled against. Override via the Robot test's setup
#     or `renode -e $xous_core_root=@/other/path` if needed.

# --- Variables ---
# $ORIGIN is tests/renode/; ../../../repos/xous-core is the
# workspace-level symlink -> the active xous-core checkout.
$xous_core_root ?= $ORIGIN/../../../repos/xous-core

# --- Boot xous-core's standard Precursor image ---
# This pulls in every peripheral wiring + kernel + base services +
# all bundled apps, including xas. betrusted.resc internally calls
# `runMacro $reset` which loads loader.bin + xous.img and sets PC.
include $xous_core_root/emulation/betrusted.resc

echo "xas-smoke: machine ready (xas bundled per apps/manifest.json)"
