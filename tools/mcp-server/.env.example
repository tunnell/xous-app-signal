# tools/mcp-server/.env.example
#
# Copy to `.env` (gitignored) and edit. Every value is also overridable
# via the same-named environment variable in your shell.
#
# No secrets live here — the Pi is on a private network and SSH key
# auth happens through your normal SSH agent / ~/.ssh/config.

# --- Pi rig -------------------------------------------------------------------

# user@host of the Raspberry Pi flashing rig. Required by flash_via_pi /
# watch_uart / lsusb_pi tools. Leave unset if you only use the
# direct-from-host flash path.
# PI_HOST=pi@10.0.0.42

# Pi-side directory holding usb_update.py and the staged xous.img.
# PI_FLASH_DIR=~/xous-flash

# Pi-side path of the long-running UART capture log. Set up once via:
#   ssh $PI_HOST 'mkdir -p ~/uart-logs && screen -dmS uart -L \
#     -Logfile ~/uart-logs/precursor-uart.log /dev/ttyAMA0 115200'
# PI_UART_LOG=~/uart-logs/precursor-uart.log

# Name of the persistent UART screen session on the Pi. Auto-detected
# via `screen -ls` if left unset.
# PI_UART_SCREEN=uart

# Pi-side directory for ad-hoc flash logs. The Python flash tool writes
# /tmp/flash-<epoch>.log here by default.
# FLASH_LOG_DIR=/tmp

# --- Build host ---------------------------------------------------------------

# Path to your xous-core checkout (adjacent to this repo by default).
# XOUS_CORE_DIR=../xous-core

# xtask app-image-xip target. Use the cargo target triple, NOT the
# legacy `precursor-c809403e` form — see CHORES.md for context. The
# xous.img lands at $XOUS_CORE_DIR/target/$XOUS_TARGET/release/xous.img.
# XOUS_TARGET=riscv32imac-unknown-xous-elf

# SoC version pins (BUILDING.md §3.2). Override per device by reading
# `lsusb -v | grep iSerial` while Precursor is in loader mode.
# GIT_DESCRIBE=v0.9.8-791-gc707f9d8
# GIT_REV=c707f9d8
