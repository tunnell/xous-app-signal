+        record: &SessionRecord,
+    ) -> Result<(), SignalProtocolError> {
+        trace!(%address, "storing session");
+        self.store
+            .insert(T::sessions(), address.to_string(), record.serialize()?)?;
+        Ok(())
+    }
+}
